# Base URL of the ERDDAP instance (required).
ERDDAPPER_ERDDAP_BASE_URL=http://localhost:8080

# Key used to trigger ERDDAP flag reloads (required).
ERDDAPPER_ERDDAP_FLAG_KEY_KEY=your_flag_key_here

# ERDDAP url used in flagKey construction.
# Optional, ERDDAPPER_ERDDAP_BASE_URL is used
# (with http:// replaced with https://) by default.
# ERDDAPPER_ERDDAP_FLAG_KEY_URL=https://localhost:8443

# Enabled dataset source classes (module:Class), comma-separated.
# ERDDAPPER_ENABLED_SOURCES=inline:NcoJsonInlineSource,asset_manager:AssetManagerSource

# Directory where generated ERDDAP XML dataset elements are stored.
# ERDDAPPER_DATASET_ELEMENTS_DIR=datasets/elements

# Directory where downloaded dataset data files are stored.
# ERDDAPPER_DATASET_DATA_DIR=datasets/data

# Path to the generated datasets.xml config file.
# ERDDAPPER_DATASETS_XML_PATH=datasets/datasets.xml

# Path to the datasets' data directory inside the ERDDAP container.
# ERDDAPPER_ERDDAP_DATASETS_PATH=/mnt/datasets/data

# How often ERDDAP should reload datasets, in minutes.
# ERDDAPPER_DATASET_RELOAD_FREQ_MIN=1440

# ERDDAP config (only used for ERDDAP setup in testing compose stack)

# ERDDAP port, default 8080
# ERDDAP_PORT=8080

# Host headers which ERDDAP should allow.
# localhost, baseUrl, and baseHttpsUrl are automatically considered.
# ERDDAP_ALLOWED_HOSTS=yourserver.local
